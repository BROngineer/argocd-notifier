# HTTP server the ArgoCD webhook notifier calls
LISTEN_ADDR=:8080
EVENTS_PATH=/events
INGEST_QUEUE_SIZE=1024
WORKER_COUNT=4

# Aggregation
GROUP_LABEL=application/name
IDLE_WINDOW=30s
MAX_WAIT=5m
COMBINE_TRIGGERS=true
SESSION_TTL=45m
# "drop" (default) or "thread" — behavior when an event's content is
# identical to what's already recorded for that app in the session
DUPLICATE_ACTION=drop

# Slack
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_REQUEST_TIMEOUT=5s
SLACK_MAX_RETRIES=3

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Leader election — opt-in, only needed when running more than 1 replica.
# Requires RBAC to get/create/update Leases in LEADER_ELECTION_NAMESPACE
# (see README's "High availability" section). Failover only — the new
# leader starts with empty in-memory session state.
LEADER_ELECTION_ENABLED=false
LEADER_ELECTION_NAMESPACE=argocd
LEASE_NAME=argocd-notifier-leader
LEASE_DURATION=15s
RENEW_DEADLINE=10s
RETRY_PERIOD=2s
# POD_NAME defaults to os.Hostname() (the pod name, in-cluster) when unset
