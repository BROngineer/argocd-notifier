{
  "packages": {
    ".": {
      "component": "release",
      "release-type": "simple",
      "bump-minor-pre-major": true,
      "include-component-in-tag": false,
      "include-v-in-tag": true,
      "include-v-in-release-name": true,
      "extra-files": [
        { "type": "yaml", "path": "chart/Chart.yaml", "jsonpath": "$.appVersion" },
        { "type": "json", "path": ".release-please-rc-manifest.json", "jsonpath": "$['.']" },
        { "type": "generic", "path": "chart/values.yaml" }
      ]
    }
  },
  "pull-request-header": ":robot: Release ready",
  "pull-request-title-pattern": "chore${scope}: ${component} ${version}",
  "changelog-sections": [
    { "type": "feat", "section": "Features", "hidden": false },
    { "type": "fix", "section": "Bug Fixes", "hidden": false },
    { "type": "chore", "section": "Miscellaneous", "hidden": false },
    { "type": "build", "hidden": true }
  ]
}
