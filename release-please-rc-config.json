{
  "packages": {
    ".": {
      "component": "release-candidate",
      "release-type": "simple",
      "versioning": "prerelease",
      "prerelease": true,
      "prerelease-type": "rc",
      "bump-minor-pre-major": true,
      "include-component-in-tag": false,
      "include-v-in-tag": true,
      "include-v-in-release-name": true,
      "skip-changelog": true,
      "changelog-sections": [
        { "type": "feat", "hidden": false },
        { "type": "fix", "hidden": false },
        { "type": "chore", "hidden": false }
      ],
      "extra-files": [
        { "type": "yaml", "path": "chart/Chart.yaml", "jsonpath": "$.appVersion" },
        { "type": "generic", "path": "chart/values.yaml" }
      ]
    }
  },
  "pull-request-header": ":robot: Release candidate ready",
  "pull-request-title-pattern": "build${scope}: ${component} ${version}"
}
